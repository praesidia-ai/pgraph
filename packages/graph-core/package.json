    "@praesidia/pgraph-store": "0.6.1",
    "@praesidia/pgraph-store-sqlite": "0.6.1",
    "@praesidia/pgraph-indexer": "0.6.1",
    "@praesidia/pgraph-query": "0.6.1",
    "@praesidia/pgraph-context": "0.6.1",
    "@praesidia/pgraph-semantic": "0.6.1",
